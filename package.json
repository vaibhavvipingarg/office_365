{
  "name": "office-365-salesforce-addin",
  "version": "1.0.0",
  "description": "Office 365 Add-in with Salesforce Integration",
  "scripts": {
    "start": "office-addin-debugging start manifest.xml web --document https://www.office.com/launch/word",
    "start:word": "office-addin-debugging start manifest.xml web --document https://www.office.com/launch/word",
    "start:powerpoint": "office-addin-debugging start manifest.xml web --document https://www.office.com/launch/powerpoint",
    "start:excel": "office-addin-debugging start manifest.xml web --document https://www.office.com/launch/excel",
    "start:outlook": "office-addin-debugging start manifest.xml web --document https://outlook.office.com",
    "start:desktop": "office-addin-debugging start manifest.xml desktop",
    "build": "webpack --mode production",
    "dev": "webpack serve --mode development",
    "local": "webpack serve --mode development --env local --port 3001",
    "standalone": "echo 'Starting standalone development server on port 8000...' && webpack serve --config webpack.standalone.js",
    "validate": "office-addin-manifest validate manifest.xml"
  },
  "dependencies": {
    "@fluentui/react": "^8.112.0",
    "@microsoft/office-js": "^1.1.0",
    "@salesforce/core": "^3.34.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.3",
    "@babel/preset-env": "^7.23.3",
    "@babel/preset-react": "^7.23.3",
    "@babel/preset-typescript": "^7.23.3",
    "@types/office-js": "^1.0.0",
    "@types/react": "^18.2.38",
    "@types/react-dom": "^18.2.17",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^6.8.1",
    "html-webpack-plugin": "^5.5.3",
    "office-addin-cli": "^1.5.5",
    "office-addin-debugging": "^5.0.5",
    "office-addin-dev-certs": "^1.7.7",
    "office-addin-manifest": "^1.7.7",
    "process": "^0.11.10",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.1",
    "typescript": "^5.3.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
